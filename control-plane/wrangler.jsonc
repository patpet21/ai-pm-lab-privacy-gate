  "vars": {"BASE_URL":"https://auth.propertydex.xyz","MCP_DOMAIN":"propertydex.xyz","SUPABASE_ISSUER":"https://miihsvfvklwvwvvgeboh.supabase.co/auth/v1","CF_ACCOUNT_ID":"ee77e23772774beb4c2c499ace77441c","CF_ZONE_ID":"a73901b6bacc6810532d922f54546799"},
