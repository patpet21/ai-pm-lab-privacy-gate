{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "privacygate-device-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "relay.propertydex.xyz", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RelayRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayRoom"] }
  ]
}
