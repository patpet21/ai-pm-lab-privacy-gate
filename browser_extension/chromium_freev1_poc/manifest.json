{
  "manifest_version": 3,
  "name": "PrivacyGate FreeV1 POC",
  "version": "0.0.14",
  "description": "PrivacyGate local browser protection proof of concept.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PrivacyGate Browser Protection",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "observer_guard.js",
        "send_gate_guard.js",
        "content.js",
        "send_gate_guard_cleanup.js",
        "assistant_restore_guard.js"
      ],
      "run_at": "document_start"
    }
  ]
}
