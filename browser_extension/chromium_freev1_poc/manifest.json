{
  "manifest_version": 3,
  "name": "PrivacyGate FreeV1 POC",
  "version": "0.0.4",
  "description": "PrivacyGate local browser protection proof of concept.",
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
