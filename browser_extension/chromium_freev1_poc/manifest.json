{
  "manifest_version": 3,
  "name": "PrivacyGate Browser Protection",
  "version": "0.0.38",
  "description": "Local-first protection for sensitive prompts, PDFs, and Word documents on supported AI websites.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "browser_background.js"
  },
  "icons": {
    "16": "privacygate-16.png",
    "32": "privacygate-32.png",
    "48": "privacygate-48.png",
    "128": "privacygate-128.png"
  },
  "action": {
    "default_title": "PrivacyGate Browser Protection",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "privacygate-16.png",
      "32": "privacygate-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "restore_overlay.html",
        "restore_overlay.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "network_gate_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "observer_guard.js",
        "network_gate_bridge.js",
        "legacy_restore_blocker.js",
        "pdf_drag_guard.js",
        "document_upload_guard.js",
        "content.js",
        "protection_state_sync.js",
        "assistant_restore_guard.js",
        "notice_center_guard.js"
      ],
      "run_at": "document_start"
    }
  ]
}
